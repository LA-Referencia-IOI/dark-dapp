# =============================================================================
# dARK Unified Environment Configuration (Reference)
# =============================================================================
# This file consolidates all environment variables needed across dARK projects.
# Copy to .env and update values as needed.
#
# NOTE: Individual modules (dark-core-api, dark-core-orchestrator) have their
# own .env files for standalone operation. This file is primarily for:
#   1. Running dark-test notebooks from the unified environment
#   2. Quick reference of all configuration options
# =============================================================================

# =============================================================================
# Blockchain Connection (shared across all projects)
# =============================================================================
DARK_RPC_URL=http://localhost:8545
DARK_CHAIN_ID=1337

# Contract Addresses (from dark-dapp/deployed_contracts.ini after deployment)
# Update these after running: cd dark-dapp && docker-compose up -d && python deploy.py
DARK_AUTHORITY_ADDRESS=0x...
DARK_CONTRACT_ADDRESS=0x...

# Admin Account (Besu development account - has gas funds)
DARK_ADMIN_PRIVATE_KEY=0xae6ae8e5ccbfb04590405997ee2d52d2b330726137b875053c36d94e974d162f

# =============================================================================
# dark-core-api specific
# =============================================================================
CORE_API_HOST=0.0.0.0
CORE_API_PORT=8000
BATCH_SIZE_LIMIT=100

# mTLS Configuration (set MTLS_ENABLED=true to require client certificates)
MTLS_ENABLED=false
TLS_CERT_FILE=/path/to/server.crt
TLS_KEY_FILE=/path/to/server.key
TLS_CA_FILE=/path/to/ca.crt


# Optional: Path to deployed_contracts.ini for ABI loading
# Leave empty to use default ABI or set to: ./dark-dapp/deployed_contracts.ini
DARK_CONTRACTS_INI_PATH=
